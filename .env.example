# Model configuration
# Model ID can be a HuggingFace hub model ID or local directory containing weights
MODEL_ID_OR_PATH=HuggingFaceTB/SmolLM-135M-Instruct
# Optional LoRA adapter path if using base model + adapter
LORA_ADAPTER_PATH=

# Device: 'auto', 'cuda', or 'cpu'
DEVICE=cpu

# Inference parameters
MAX_NEW_TOKENS=512
TEMPERATURE=0.2
TOP_P=0.9

# Server configuration
PORT=8000
HOST=0.0.0.0
DEBUG=False
